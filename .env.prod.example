# Produksi HRIS SDM AL-WILDAN v3.1 — salin ke .env (satu folder dgn docker-compose.yml), chmod 600
# Buat nilai acak: openssl rand -base64 32
# WAJIB: server menolak start bila AUTH_SECRET <32 karakter atau placeholder.
AUTH_SECRET=ganti-dengan-minimal-32-karakter-acak
DB_PASSWORD=ganti-dengan-password-db-acak
# Domain publik organisasi (same-origin via Hono → boleh kosong)
CORS_ORIGIN=
# ---- Gmail API (OAuth server-side, AMAN: token di DB encrypt, secret JAMA di frontend) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web application)
# Authorized redirect URI: https://hr.office-alwildan.id/api/mail/oauth/callback
# Scope di consent screen: gmail.send
GOOGLE_CLIENT_ID=729501212363-q54tde6taopefqg82nqo5kbrmlc8d4il.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ganti-dengan-client-secret-google
GOOGLE_REDIRECT_URI=https://hr.office-alwildan.id/api/mail/oauth/callback
PUBLIC_DOMAIN=hr.office-alwildan.id
