# Produksi HR 3.0 — salin ke .env (satu folder dengan docker-compose.yml), chmod 600
# Buat nilai acak: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-minimal-32-karakter-acak
DB_PASSWORD=ganti-dengan-password-db-acak
# Domain publik HRIS (same-origin via Hono → boleh kosong)
CORS_ORIGIN=
# Nextcloud opsional
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASS=
NEXTCLOUD_GROUPFOLDER=Arsip SDM
# AI opsional utk parse PDF SDM (OpenAI-compatible; cth. Ollama lokal).
# Kosong = murni regex deterministik (tanpa AI, tanpa kirim data keluar).
# AI_API_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=
# AI_MODEL=qwen2.5:7b
