# HR 3.0 API pilot AW3 — salin ke .env lalu isi
# Database (contoh lokal Homebrew; ganti user/db sesuai mesin)
DATABASE_URL=postgres://kemal@localhost:5432/hr30_aw3
# Rahasia sesi (wajib acak di produksi): openssl rand -base64 32
AUTH_SECRET=ubah-saya-dengan-rahasia-acak
# Port API (frontend dev proxy / reverse proxy menunjuk ke sini)
PORT=3000
# Folder frontend hasil build (default ../web/dist)
PUBLIC_DIR=../web/dist
# Cookie Secure hanya bila di belakang HTTPS (produksi: 1)
COOKIE_SECURE=0
# Origin frontend yang boleh memanggil API (koma bila >1). Produksi: domain https HRIS.
CORS_ORIGIN=http://127.0.0.1:5173
# Nextcloud opsional — kosongkan untuk menonaktifkan
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASS=
NEXTCLOUD_GROUPFOLDER=Arsip SDM
# Reset kata sandi via Resend (https://resend.com/api-keys). Kosongkan = mode dev (tautan hanya di log server).
RESEND_API_KEY=
# Pengirim — wajib domain terverifikasi di Resend (cth. "HRIS AL-WILDAN <hr@alwildan.sch.id>").
RESEND_FROM=
# Basis URL publik untuk tautan reset (kosongkan = ikut CORS_ORIGIN).
APP_URL=
